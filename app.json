{
  "expo": {
    "name": "Steppa",
    "slug": "steppa",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "steppa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cs.steppa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1EBE0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.steppa.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EBE0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Steppa uses Face ID to unlock the app."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Steppa reads your step count to show your progress and compare it with your groups.",
          "NSHealthUpdateUsageDescription": "Steppa does not write health data.",
          "background": true
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#006C4C"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "StepsWidget",
              "displayName": "Steps",
              "description": "Today’s steps and your goal ring.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "PetWidget",
              "displayName": "Pet",
              "description": "Your pet, and how it’s feeling today.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Steps",
              "label": "Steps",
              "description": "Today’s steps and your goal ring",
              "previewImage": "./assets/images/widgets/steps-preview.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Pet",
              "label": "Pet",
              "description": "Your pet, and how it’s feeling today",
              "previewImage": "./assets/images/widgets/pet-preview.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77d582b1-de90-48cb-a374-6ffd1a25ccf0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/77d582b1-de90-48cb-a374-6ffd1a25ccf0"
    }
  }
}
